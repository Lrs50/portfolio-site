# Public values baked into the site at build time (Vite). Nothing here is secret.
# Cloudflare Pages builds with this file. Copy .env.example for the full list.

# Final address of the site (used for the link preview image and the canonical tag).
# TODO: replace with the real address shown in Cloudflare Pages.
VITE_SITE_URL=https://lucasreis.pages.dev

# Where the Resume button goes. Template for now: while these are empty the button just returns to the main page.
# TODO: fill in when the resume pages exist (English is used everywhere except when the site language is Portuguese).
VITE_RESUME_URL_EN=https://www.google.com
VITE_RESUME_URL_PT=https://www.google.com
