# Copy to .env.production (build) or .env.development (npm run dev) and adjust.
# These are public values: Vite writes them into the site, so never put private keys here.

# Final address of the site (link preview image and canonical tag)
VITE_SITE_URL=https://your-project.pages.dev

# Resume page for the Resume button (English; also used for every language except Portuguese)
VITE_RESUME_URL_EN=
# Resume page used when the site language is Portuguese
VITE_RESUME_URL_PT=
